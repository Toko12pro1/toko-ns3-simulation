//=============================================================================
// SD-WAN Controller Class
//=============================================================================
class SdWanController {
public:
    SdWanController(Ptr<Node> router, Time interval, Ptr<FlowMonitor> monitor) 
        : m_routerNode(router), m_updateInterval(interval), m_flowMonitor(monitor) {
        m_latencyThreshold = 30.0; // milliseconds
        ScheduleNextUpdate();
    }

    void ScheduleNextUpdate() {
        m_updateEvent = Simulator::Schedule(m_updateInterval, 
                                           &SdWanController::PeriodicUpdate, this);
    }

    void PeriodicUpdate() {
        NS_LOG_INFO("=== SD-WAN Controller Update at " << Simulator::Now().GetSeconds() << "s ===");
        
        // Step 1: Fetch current path metrics
        FetchLinkMetrics();
        
        // Step 2: Apply policy rules
        ApplyPolicyRules();
        
        // Step 3: Schedule next update
        ScheduleNextUpdate();
    }

    void FetchLinkMetrics() {
        // Use FlowMonitor to get real-time statistics
        m_flowMonitor->CheckForLostPackets();
        Ptr<Ipv4FlowClassifier> classifier = DynamicCast<Ipv4FlowClassifier>(
            m_flowMonitor->GetClassifier());
        
        std::map<FlowId, FlowMonitor::FlowStats> stats = m_flowMonitor->GetFlowStats();
        
        // Reset metrics
        g_linkLatency[1] = 0.0;
        g_linkLatency[2] = 0.0;
        
        for (auto& flow : stats) {
            Ipv4FlowClassifier::FiveTuple t = classifier->FindFlow(flow.first);
            
            if (flow.second.rxPackets > 0) {
                double latency = flow.second.delaySum.GetMilliSeconds() / flow.second.rxPackets;
                
                // Classify by port and store metrics
                if (t.destinationPort == VIDEO_PORT) {
                    g_linkLatency[1] = latency; // Assuming video uses primary initially
                    NS_LOG_INFO("  Video Flow Latency: " << latency << " ms");
                } else if (t.destinationPort == DATA_PORT) {
                    g_linkLatency[2] = latency;
                    NS_LOG_INFO("  Data Flow Latency: " << latency << " ms");
                }
            }
        }
    }

    void ApplyPolicyRules() {
        // Policy Rule: If video latency > 30ms on primary, switch to secondary
        if (g_linkLatency[1] > m_latencyThreshold && g_videoFlowInterface == 1) {
            NS_LOG_WARN("*** PRIMARY LINK DEGRADED! Switching video traffic to secondary link ***");
            g_videoFlowInterface = 2;
            UpdateRoutingTable();
        } 
        else if (g_linkLatency[1] <= m_latencyThreshold && g_videoFlowInterface == 2) {
            NS_LOG_INFO("*** Primary link recovered. Switching video traffic back ***");
            g_videoFlowInterface = 1;
            UpdateRoutingTable();
        }
    }

    void UpdateRoutingTable() {
        // In a real implementation, this would modify routing tables
        // For this simulation, we use the global variable g_videoFlowInterface
        // which is checked by our custom packet processing function
        NS_LOG_INFO("  Updated routing: Video traffic now uses interface " << g_videoFlowInterface);
    }

private:
    Ptr<Node> m_routerNode;
    Time m_updateInterval;
    Ptr<FlowMonitor> m_flowMonitor;
    EventId m_updateEvent;
    double m_latencyThreshold;
};

//=============================================================================
// Custom Routing Function (Policy-Based Routing Logic)
//=============================================================================
bool CustomIpv4RouteInput(Ptr<const Packet> p, const Ipv4Header &header, 
                          Ptr<const NetDevice> idev, UnicastForwardCallback ucb,
                          MulticastForwardCallback mcb, LocalDeliverCallback lcb,
                          ErrorCallback ecb) {
    
    // Extract UDP header to get destination port
    Ptr<Packet> packet = p->Copy();
    UdpHeader udpHeader;
    packet->PeekHeader(udpHeader);
    
    uint16_t destPort = udpHeader.GetDestinationPort();
    
    NS_LOG_DEBUG("Routing decision for packet to port " << destPort);
    
    // Policy-Based Routing Logic
    if (destPort == VIDEO_PORT) {
        // Route video traffic based on current policy
        NS_LOG_DEBUG("  -> Video traffic routed to interface " << g_videoFlowInterface);
        // Return false to allow default routing with modified interface preference
    } else if (destPort == DATA_PORT) {
        // Route data traffic to secondary link
        NS_LOG_DEBUG("  -> Data traffic routed to interface 2");
    }
    
    // Let default routing handle the actual forwarding
    return false;
}

//=============================================================================
// Main Simulation
//=============================================================================
int main(int argc, char *argv[]) {
    
    // Enable logging
    LogComponentEnable("PolicyBasedRouting", LOG_LEVEL_INFO);
    
    // Simulation parameters
    double simTime = 60.0;
    uint32_t maxPackets = 10000;
    
    // Parse command line
    CommandLine cmd;
    cmd.AddValue("simTime", "Simulation time in seconds", simTime);
    cmd.Parse(argc, argv);
    
    NS_LOG_INFO("=== Policy-Based Routing Simulation ===");
    
    //=========================================================================
    // Step 1: Create Network Topology
    //=========================================================================
    NS_LOG_INFO("Creating network topology...");
    
    NodeContainer nodes;
    nodes.Create(3); // Studio, Cloud, Intermediate (for dual path)
    
    Ptr<Node> studioNode = nodes.Get(0);
    Ptr<Node> cloudNode = nodes.Get(1);
    Ptr<Node> intermediateNode = nodes.Get(2); // For secondary path
    
    // Point-to-point helpers
    PointToPointHelper p2pPrimary;
    p2pPrimary.SetDeviceAttribute("DataRate", StringValue("10Mbps"));
    p2pPrimary.SetChannelAttribute("Delay", StringValue("10ms"));
    
    PointToPointHelper p2pSecondary;
    p2pSecondary.SetDeviceAttribute("DataRate", StringValue("5Mbps"));
    p2pSecondary.SetChannelAttribute("Delay", StringValue("5ms"));
    
    // Create two paths
    NetDeviceContainer devicesStudioCloud = p2pPrimary.Install(studioNode, cloudNode);
    NetDeviceContainer devicesStudioIntermediate = p2pSecondary.Install(studioNode, intermediateNode);
    NetDeviceContainer devicesIntermediateCloud = p2pSecondary.Install(intermediateNode, cloudNode);
    
    //=========================================================================
    // Step 2: Install Internet Stack
    //=========================================================================
    InternetStackHelper internet;
    internet.Install(nodes);
    
    //=========================================================================
    // Step 3: Assign IP Addresses
    //=========================================================================
    Ipv4AddressHelper address;
    
    // Primary path: 10.1.1.0/24
    address.SetBase("10.1.1.0", "255.255.255.0");
    Ipv4InterfaceContainer ifacesStudioCloud = address.Assign(devicesStudioCloud);
    
    // Secondary path part 1: 10.1.2.0/24
    address.SetBase("10.1.2.0", "255.255.255.0");
    Ipv4InterfaceContainer ifacesStudioIntermediate = address.Assign(devicesStudioIntermediate);
    
    // Secondary path part 2: 10.1.3.0/24
    address.SetBase("10.1.3.0", "255.255.255.0");
    Ipv4InterfaceContainer ifacesIntermediateCloud = address.Assign(devicesIntermediateCloud);
    
    //=========================================================================
    // Step 4: Setup Routing
    //=========================================================================
    Ipv4GlobalRoutingHelper::PopulateRoutingTables();
    
    //=========================================================================
    // Step 5: Create Applications
    //=========================================================================
    NS_LOG_INFO("Installing applications...");
    
    // Server applications on Cloud node
    uint16_t videoPort = VIDEO_PORT;
    uint16_t dataPort = DATA_PORT;
    
    UdpEchoServerHelper videoServer(videoPort);
    UdpEchoServerHelper dataServer(dataPort);
    
    ApplicationContainer serverApps;
    serverApps.Add(videoServer.Install(cloudNode));
    serverApps.Add(dataServer.Install(cloudNode));
    serverApps.Start(Seconds(0.0));
    serverApps.Stop(Seconds(simTime));
    
    // Client applications on Studio node
    Ipv4Address cloudAddr = ifacesStudioCloud.GetAddress(1);
    
    // Video Traffic Application
    Ptr<VideoTrafficApp> videoApp = CreateObject<VideoTrafficApp>();
    videoApp->Setup(InetSocketAddress(cloudAddr, videoPort), 200, MilliSeconds(20), maxPackets);
    studioNode->AddApplication(videoApp);
    videoApp->SetStartTime(Seconds(1.0));
    videoApp->SetStopTime(Seconds(simTime));
    
    // Data Traffic Application
    Ptr<DataTrafficApp> dataApp = CreateObject<DataTrafficApp>();
    dataApp->Setup(InetSocketAddress(cloudAddr, dataPort), 1400, MilliSeconds(100), maxPackets/10);
    studioNode->AddApplication(dataApp);
    dataApp->SetStartTime(Seconds(1.0));
    dataApp->SetStopTime(Seconds(simTime));
    
    //=========================================================================
    // Step 6: Install FlowMonitor for Metrics Collection
    //=========================================================================
    NS_LOG_INFO("Installing FlowMonitor...");
    FlowMonitorHelper flowHelper;
    Ptr<FlowMonitor> flowMonitor = flowHelper.InstallAll();
    
    //=========================================================================
    // Step 7: Create SD-WAN Controller
    //=========================================================================
    NS_LOG_INFO("Creating SD-WAN Controller...");
    SdWanController controller(studioNode, Seconds(1.0), flowMonitor);
    
    //=========================================================================
    // Step 8: Simulate Link Degradation (optional)
    //=========================================================================
    // At t=30s, increase delay on primary link to trigger failover
    Simulator::Schedule(Seconds(30.0), [&devicesStudioCloud]() {
        NS_LOG_WARN("!!! SIMULATING PRIMARY LINK DEGRADATION at t=30s !!!");
        Ptr<PointToPointNetDevice> dev = DynamicCast<PointToPointNetDevice>(devicesStudioCloud.Get(0));
        Ptr<PointToPointChannel> channel = DynamicCast<PointToPointChannel>(dev->GetChannel());
        channel->SetAttribute("Delay", TimeValue(MilliSeconds(50))); // Increase to 50ms
    });
    
    // At t=45s, restore primary link
    Simulator::Schedule(Seconds(45.0), [&devicesStudioCloud]() {
        NS_LOG_INFO("!!! RESTORING PRIMARY LINK at t=45s !!!");
        Ptr<PointToPointNetDevice> dev = DynamicCast<PointToPointNetDevice>(devicesStudioCloud.Get(0));
        Ptr<PointToPointChannel> channel = DynamicCast<PointToPointChannel>(dev->GetChannel());
        channel->SetAttribute("Delay", TimeValue(MilliSeconds(10))); // Back to 10ms
    });
    
    //=========================================================================
    // Step 9: Run Simulation
    //=========================================================================
    NS_LOG_INFO("Running simulation for " << simTime << " seconds...");
    
    Simulator::Stop(Seconds(simTime));
    Simulator::Run();
    
    //=========================================================================
    // Step 10: Print Statistics
    //=========================================================================
    NS_LOG_INFO("\n=== Final Statistics ===");
    
    flowMonitor->CheckForLostPackets();
    Ptr<Ipv4FlowClassifier> classifier = DynamicCast<Ipv4FlowClassifier>(flowHelper.GetClassifier());
    std::map<FlowId, FlowMonitor::FlowStats> stats = flowMonitor->GetFlowStats();
    
    for (auto& flow : stats) {
        Ipv4FlowClassifier::FiveTuple t = classifier->FindFlow(flow.first);
        
        std::cout << "Flow " << flow.first << " (" << t.sourceAddress << ":" << t.sourcePort 
                  << " -> " << t.destinationAddress << ":" << t.destinationPort << ")\n";
        std::cout << "  Tx Packets: " << flow.second.txPackets << "\n";
        std::cout << "  Rx Packets: " << flow.second.rxPackets << "\n";
        std::cout << "  Lost Packets: " << flow.second.lostPackets << "\n";
        
        if (flow.second.rxPackets > 0) {
            std::cout << "  Avg Delay: " << flow.second.delaySum.GetMilliSeconds() / flow.second.rxPackets 
                      << " ms\n";
            std::cout << "  Throughput: " << flow.second.rxBytes * 8.0 / simTime / 1e6 << " Mbps\n";
        }
        std::cout << std::endl;
    }
    
    Simulator::Destroy();
    NS_LOG_INFO("Simulation complete!");
    
    return 0;
}
